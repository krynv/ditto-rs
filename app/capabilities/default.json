{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the quick-paste and options windows may do; app commands are defined in src/commands.rs.",
  "windows": ["popup", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
